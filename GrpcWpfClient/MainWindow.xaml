<Window
    x:Class="GrpcWpfClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="gRPC Client Demo"
    Width="480"
    Height="400"
    WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock
            FontSize="20"
            FontWeight="SemiBold"
            Text="Call the gRPC backend" />
        <TextBlock Margin="0,20,0,4" Text="Backend HTTPS address (C#: 7044, Python: 7045)" />
        <TextBox
            x:Name="BackendAddressTextBox"
            Height="32"
            Text="https://localhost:7044" />
        <TextBlock Margin="0,20,0,4" Text="Name" />
        <TextBox
            x:Name="NameTextBox"
            Height="32"
            Text="World" />
        <Button
            Width="120"
            Height="32"
            Margin="0,12,0,12"
            HorizontalAlignment="Left"
            Click="OnSayHelloClick"
            Content="Say hello" />
        <TextBlock
            x:Name="ResponseTextBlock"
            Text="Start GrpcBackend before sending a request."
            TextWrapping="Wrap" />
    </StackPanel>
</Window>
