<Window
    x:Class="ErrorHandlingLoggingWpf.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Error Handling and Logging Demo"
    Width="640"
    Height="380"
    MinWidth="560"
    MinHeight="320"
    WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Error handling and logging" />
        <TextBlock Margin="0,8,0,20" TextWrapping="Wrap">
            Logs are written to a daily rolling file and Visual Studio's Debug output. The unhandled exception button demonstrates the global WPF dispatcher handler and may close the application after logging.
        </TextBlock>
        <WrapPanel>
            <Button
                Margin="0,0,8,8"
                Padding="12,6"
                Click="OnRunSuccessClick"
                Content="Run successfully" />
            <Button
                Margin="0,0,8,8"
                Padding="12,6"
                Click="OnHandledFailureClick"
                Content="Simulate handled failure" />
            <Button
                Margin="0,0,8,8"
                Padding="12,6"
                Click="OnUnhandledFailureClick"
                Content="Simulate unhandled UI failure" />
        </WrapPanel>
        <Border
            Margin="0,12,0,0"
            Padding="12"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</Window>
