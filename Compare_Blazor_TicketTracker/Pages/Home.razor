@page "/"
@using Compare_Blazor_TicketTracker.Components
@using Compare_Blazor_TicketTracker.Models
@using Compare_Blazor_TicketTracker.Services
@inject TicketService Service
@inject AuthService Auth

<PageTitle>Ticket Tracker</PageTitle>

<RequireAuth>
    @if (Service.ActionError != "")
    {
        <p class="error">@Service.ActionError</p>
    }

    <div class="stats">
        @foreach (var s in TicketLabels.Statuses)
        {
            <div class="stat @s.Css()">
                <strong>@Service.Count(s)</strong>
                <span>@s.Label()</span>
            </div>
        }
    </div>

    <TicketForm OnAdd="Service.AddAsync" />

    <div class="toolbar">
        <input type="search" placeholder="Tickets durchsuchen..." @bind="Service.Search" @bind:event="oninput" />
        <select aria-label="Filter" @bind="Service.Filter">
            <option value="all">Alle</option>
            @foreach (var s in TicketLabels.Statuses)
            {
                <option value="@s">@s.Label()</option>
            }
        </select>
    </div>

    @if (Service.Loading)
    {
        <p class="empty">Lade Tickets...</p>
    }
    @if (Service.LoadError != "")
    {
        <p class="error">@Service.LoadError <button @onclick="Service.LoadAsync">Erneut versuchen</button></p>
    }

    <ul class="tickets">
        @foreach (var t in Service.Visible)
        {
            <TicketItem @key="t.Id" Ticket="t"
                        OnStatusChange="status => Service.ChangeStatusAsync(t.Id, status)"
                        OnDelete="() => Service.RemoveAsync(t.Id)" />
        }
    </ul>
    @if (!Service.Loading && Service.LoadError == "" && Service.VisibleCount == 0)
    {
        <p class="empty">Keine Tickets gefunden.</p>
    }
</RequireAuth>

@code {
    // Lifecycle-Methode (Gegenstueck zu useEffect/ngOnInit): einmal beim Start laden.
    // Wartet auf die Anmeldung, damit der erste Request das Token enthaelt.
    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (Auth.IsLoggedIn) await Service.LoadAsync();
    }
}
