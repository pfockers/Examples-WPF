@using Compare_Blazor_TicketTracker.Models

<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="form" FormName="ticket-form">
    <DataAnnotationsValidator />
    <div class="field">
        <InputText @bind-Value="_model.Title" placeholder="Neues Ticket..." />
        <ValidationMessage For="() => _model.Title" />
    </div>
    <InputSelect @bind-Value="_model.Priority">
        @foreach (var p in TicketLabels.Priorities)
        {
            <option value="@p">@p.Label()</option>
        }
    </InputSelect>
    <button type="submit" class="primary" disabled="@_busy">@(_busy ? "Speichern..." : "Hinzufuegen")</button>
</EditForm>

@code {
    // EventCallback entspricht dem onAdd-Prop in React bzw. @Output in Angular.
    [Parameter] public EventCallback<TicketInput> OnAdd { get; set; }

    private TicketInput _model = new();
    private bool _busy;

    // OnValidSubmit wird nur aufgerufen, wenn alle DataAnnotations erfuellt sind.
    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            _model.Title = _model.Title.Trim();
            await OnAdd.InvokeAsync(_model);
            _model = new TicketInput { Priority = _model.Priority };
        }
        finally
        {
            _busy = false;
        }
    }
}
