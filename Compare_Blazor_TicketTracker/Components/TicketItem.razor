@using Compare_Blazor_TicketTracker.Models

<li class="ticket @Ticket.Status.Css()">
    <div class="ticket-main">
        <span class="priority @Ticket.Priority.Css()">@Ticket.Priority.Label()</span>
        <span class="title">@Ticket.Title</span>
        <small>@Ticket.CreatedAt.ToString("dd.MM.yyyy")</small>
    </div>
    <div class="ticket-actions">
        <select value="@Ticket.Status" @onchange="e => OnStatusChange.InvokeAsync(Enum.Parse<Status>(e.Value!.ToString()!))">
            @foreach (var s in TicketLabels.Statuses)
            {
                <option value="@s">@s.Label()</option>
            }
        </select>
        <button class="danger" @onclick="() => OnDelete.InvokeAsync()" aria-label="Loeschen">&times;</button>
    </div>
</li>

@code {
    // [Parameter] und EventCallback entsprechen React-Props bzw. Angular @Input/@Output.
    [Parameter, EditorRequired] public Ticket Ticket { get; set; } = default!;
    [Parameter] public EventCallback<Status> OnStatusChange { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}
