<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:WpfAdvancedTraining.Controls"
                    xmlns:converters="clr-namespace:WpfAdvancedTraining.Converters">
    <converters:LockStateConverter x:Key="LockStateConverter" />
    <Style TargetType="{x:Type controls:UserCardControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:UserCardControl}">
                    <Border x:Name="CardBorder"
                            Padding="14"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{TemplateBinding UserName}" />
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{TemplateBinding Role}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding IsLocked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LockStateConverter}}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLocked" Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFD84A4A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
