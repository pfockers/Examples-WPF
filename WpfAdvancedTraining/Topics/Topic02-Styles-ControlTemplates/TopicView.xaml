<UserControl x:Class="WpfAdvancedTraining.Topics.Topic02StylesControlTemplates.TopicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
    <StackPanel Margin="12"><TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Text="The shared resource dictionary applies a consistent Button style. Its ControlTemplate redraws the button and reacts to hover and disabled states."/><StackPanel Orientation="Horizontal"><Button Content="Primary action"/><Button Content="Disabled example" IsEnabled="False"/></StackPanel><Border Margin="3,12,3,0" Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"><TextBlock Text="Try hovering the primary button. Both controls share an implicit Button style; its ControlTemplate changes opacity on hover and when disabled."/></Border></StackPanel>
</UserControl>
