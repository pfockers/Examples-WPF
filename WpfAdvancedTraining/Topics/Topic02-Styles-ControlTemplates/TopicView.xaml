<UserControl x:Class="WpfAdvancedTraining.Topics.Topic02StylesControlTemplates.TopicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FormActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FormActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FormActionButtonStyle}">
            <Setter Property="Background" Value="#FFB83232" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="OutlinedActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FormActionButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Styles and ControlTemplates in a user form" />
            <TextBlock Margin="0,5,0,16" Foreground="{DynamicResource MutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Text="A user-edit form needs a clear primary action, a safe way to cancel, and a visually distinct destructive action. Styles give these buttons consistent, reusable roles." />

            <Border Padding="16" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Edit sample user" />
                    <TextBlock Margin="0,12,0,3" Text="Display name" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,3" Text="Email address" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="Delete" Style="{StaticResource DangerActionButtonStyle}"
                                Command="{Binding DeleteCommand}" CommandParameter="{Binding}" />
                        <Button Content="Cancel" Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding CancelCommand}" CommandParameter="{Binding}" />
                        <Button Content="Save changes" Style="{StaticResource FormActionButtonStyle}"
                                Command="{Binding SaveCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <TextBlock Margin="3,8,3,0" Foreground="{DynamicResource MutedForegroundBrush}"
                               Text="{Binding FormMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <GroupBox Margin="0,14,0,0" Padding="10" Header="One action, a different ControlTemplate">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="This button has the same Save action role but uses a custom template. Hover, press, or tab to it to see the template triggers." />
                    <Button Width="150" HorizontalAlignment="Left" Content="Save changes"
                            Style="{StaticResource OutlinedActionButtonStyle}"
                            Command="{Binding SaveCommand}" CommandParameter="{Binding}" />
                </StackPanel>
            </GroupBox>

            <Border Margin="0,14,0,0" Padding="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <TextBlock FontFamily="Consolas" TextWrapping="Wrap"
                           Text="BasedOn reuses shared setters → named styles define action roles → ControlTemplate changes visuals and interaction states." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
