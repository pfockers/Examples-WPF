<UserControl
    x:Class="WpfAdvancedTraining.Topics.Topic14ResourceDictionaries.TopicView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="12">
        <TextBlock
            Margin="0,0,0,10"
            Text="Colors and styles are split into resource dictionaries. Switch the theme at the top of the window; this DynamicResource surface and shared button update at runtime."
            TextWrapping="Wrap" />
        <Border
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Themed surface" />
                <TextBlock Margin="0,6,0,0" Text="This panel and the shared controls respond to the selected theme." />
                <Button
                    Width="140"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Content="Themed button" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
