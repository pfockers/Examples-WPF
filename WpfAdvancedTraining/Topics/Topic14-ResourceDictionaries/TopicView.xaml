<UserControl x:Class="WpfAdvancedTraining.Topics.Topic14ResourceDictionaries.TopicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
    <StackPanel Margin="12"><TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Text="Colors and styles are split into resource dictionaries. Switch the theme at the top of the window; this DynamicResource surface and shared button update at runtime."/><Border Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Themed surface"/><TextBlock Margin="0,6,0,0" Text="This panel and the shared controls respond to the selected theme."/><Button Width="140" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Themed button"/></StackPanel></Border></StackPanel>
</UserControl>
