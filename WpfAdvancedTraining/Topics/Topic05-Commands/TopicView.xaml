<UserControl x:Class="WpfAdvancedTraining.Topics.Topic05Commands.TopicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="Each row button sends its own user object as CommandParameter. Lock or unlock without selecting the row first."/><ListBox Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2"><Button DockPanel.Dock="Right" Content="Lock / unlock" Command="{Binding DataContext.LockUserCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><TextBlock VerticalAlignment="Center" Text="{Binding Name}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
</UserControl>
