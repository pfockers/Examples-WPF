<UserControl
    x:Class="WpfAdvancedTraining.Topics.Topic13DependencyProperties.TopicView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WpfAdvancedTraining.Controls">
    <StackPanel Margin="12">
        <TextBlock
            Margin="0,0,0,10"
            Text="Select a user to update the card. UserName, Role, and IsLocked are dependency properties rendered by Themes/Generic.xaml."
            TextWrapping="Wrap" />
        <controls:UserCardControl
            Width="320"
            HorizontalAlignment="Left"
            IsLocked="{Binding SelectedUser.IsLocked}"
            Role="{Binding SelectedUser.Role, TargetNullValue='Role'}"
            UserName="{Binding SelectedUser.Name, TargetNullValue='Select a user'}" />
        <ComboBox
            Width="320"
            Margin="3,10,3,3"
            HorizontalAlignment="Left"
            ItemsSource="{Binding Users}"
            SelectedItem="{Binding SelectedUser}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </StackPanel>
</UserControl>
