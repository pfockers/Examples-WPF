<UserControl x:Class="WpfAdvancedTraining.Topics.Topic01Templates.TopicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfAdvancedTraining.Models"
             xmlns:selectors="clr-namespace:WpfAdvancedTraining.Selectors">
    <UserControl.Resources>
        <DataTemplate x:Key="AdminUserTemplate" DataType="{x:Type models:AdminUserViewModel}">
            <Border Padding="8" Background="#FFEAF0FF" CornerRadius="4"><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" FontWeight="Bold" Text="ADMIN"/><TextBlock Text="{Binding Name}"/><TextBlock Margin="8,0,0,0" Foreground="#FF526173" Text="{Binding Email}"/></StackPanel></Border>
        </DataTemplate>
        <DataTemplate x:Key="RegularUserTemplate" DataType="{x:Type models:RegularUserViewModel}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}"/><TextBlock Margin="8,0,0,0" Foreground="#FF526173" Text="{Binding Email}"/></StackPanel>
        </DataTemplate>
        <selectors:UserTemplateSelector x:Key="UserTemplateSelector" AdminTemplate="{StaticResource AdminUserTemplate}" RegularTemplate="{StaticResource RegularUserTemplate}" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap"
                       Text="The selector chooses a template from each item's type: administrators get an admin label; regular users get a plain row. Click a row to select it and update the preview below." />
            <TextBlock Margin="0,5,0,0" FontFamily="Consolas"
                       Text="AdminUserViewModel → AdminUserTemplate | RegularUserViewModel → RegularUserTemplate" />
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Users}"
                 SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                 ItemTemplateSelector="{StaticResource UserTemplateSelector}" />
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Selected item preview" />
                <ContentControl Content="{Binding SelectedUser}"
                                ContentTemplateSelector="{StaticResource UserTemplateSelector}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
