<UserControl x:Class="WpfAdvancedTraining.Topics.Topic10Navigation.TopicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WpfAdvancedTraining.Views" xmlns:viewModels="clr-namespace:WpfAdvancedTraining.ViewModels" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
    <UserControl.Resources><DataTemplate DataType="{x:Type viewModels:DemoPageViewModel}"><views:DemoPageView/></DataTemplate></UserControl.Resources>
    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><Button HorizontalContentAlignment="Left" Content="User list" Command="{Binding ShowListCommand}"/><Button HorizontalContentAlignment="Left" Content="Selected user details" Command="{Binding OpenDetailsCommand}" CommandParameter="{Binding SelectedUser}"/><TextBlock Margin="4,10,4,0" TextWrapping="Wrap" Text="Select a user on another topic, then use these commands to switch the nested ContentControl between list and detail views."/></StackPanel><ContentControl Grid.Column="1" Margin="12,0,0,0" Content="{Binding CurrentView}"/></Grid>
</UserControl>
