<Window
    x:Class="DependencyInjectionWpf.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dependency Injection Demo"
    Width="480"
    Height="400"
    WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock
            FontSize="20"
            FontWeight="SemiBold"
            Text="Dependency Injection in WPF" />
        <TextBlock Margin="0,20,0,4" Text="Name" />
        <TextBox Height="32" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        <Button
            Width="100"
            Height="32"
            Margin="0,12,0,12"
            HorizontalAlignment="Left"
            Click="OnGreetClick"
            Content="Greet" />
        <TextBlock
            FontSize="14"
            Text="{Binding Greeting}"
            TextWrapping="Wrap" />
    </StackPanel>
</Window>
