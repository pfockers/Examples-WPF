<Window
    x:Class="CustomWpfControl.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ViewModels="clr-namespace:CustomWpfControl.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CustomWpfControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Custom Control Demo"
    Width="420"
    Height="220"
    d:DataContext="{d:DesignInstance ViewModels:MainWindowViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.DataContext>
        <ViewModels:MainWindowViewModel />
    </Window.DataContext>
    <StackPanel Margin="24">
        <TextBlock Margin="0,0,0,8" Text="CustomTextControl" />
        <local:CustomTextControl Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            Margin="0,16,0,0"
            Text="{Binding Text}"
            TextWrapping="Wrap" />
    </StackPanel>
</Window>
