<Window
    x:Class="SecurePasswordInput.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ViewModels="clr-namespace:SecurePasswordInput.ViewModels"
    xmlns:behaviors="clr-namespace:SecurePasswordInput.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Passwort"
    Width="360"
    Height="180"
    d:DataContext="{d:DesignInstance ViewModels:MainWindowViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <StackPanel Margin="24">
        <TextBlock Margin="0,0,0,8" Text="Passwort" />
        <PasswordBox
            Height="32"
            behaviors:PasswordBoxBinding.IsEnabled="True"
            behaviors:PasswordBoxBinding.SecurePassword="{Binding Password, Mode=TwoWay}" />
    </StackPanel>
</Window>
